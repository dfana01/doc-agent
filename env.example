
# ---
# Server 
# LLM API Keys
# Anthropic Claude - used for main agent reasoning
# Get your key: https://console.anthropic.com/settings/keys
SERVER_ANTHROPIC_API_KEY=sk-ant-...

# OpenAI - used for image processing (GPT-4o Vision)
# Get your key: https://platform.openai.com/api-keys
SERVER_OPENAI_API_KEY=sk-proj-...

# AWS Configuration
SERVER_AWS_REGION=us-east-1

# S3 Configuration
# For local dev (LocalStack) - works out of the box with `make local-services-up`:
SERVER_S3_BUCKET=ai-agent-documents-local
SERVER_S3_ENDPOINT=http://localhost:4566

# For AWS (comment out S3_ENDPOINT and set your bucket):
# SERVER_S3_BUCKET=your-bucket-name
# SERVER_S3_ENDPOINT=

# DynamoDB Configuration (for job queue)
# For local dev (LocalStack):
SERVER_DYNAMODB_JOBS_TABLE=ai-agent-jobs
SERVER_DYNAMODB_ENDPOINT=http://localhost:4566

# For AWS (comment out DYNAMODB_ENDPOINT):
# SERVER_DYNAMODB_JOBS_TABLE=your-table-name
# SERVER_DYNAMODB_ENDPOINT=

# OpenSearch Configuration  
# For local dev (Docker) - works out of the box with `make local-services-up`:
SERVER_OPENSEARCH_ENDPOINT=http://localhost:9200

# For AWS (use your OpenSearch domain endpoint):
# SERVER_OPENSEARCH_ENDPOINT=https://search-xxx.us-east-1.es.amazonaws.com

SERVER_OPENSEARCH_INDEX=documents

# SEC EDGAR Configuration
# Required for downloading 10-K filings (SEC requires identification)
# Used by: make download-sec-filings
SEC_COMPANY_NAME=Your Company Name
SEC_EMAIL=your@email.com
SEC_FILING_LIMIT=5

# ---
# Client
# VITE_ prefix exposes vars to browser - never put secrets here!
VITE_API_URL=/api
